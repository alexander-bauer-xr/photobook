APP_NAME="Photobook"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --------------------------------------------------------------------------
# Database
# --------------------------------------------------------------------------
# SQLite is recommended for the first local/self-hosted setup.
DB_CONNECTION=sqlite

# For MySQL/PostgreSQL, configure these instead:
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=photobook
# DB_USERNAME=photobook
# DB_PASSWORD=

# --------------------------------------------------------------------------
# Sessions / queue / cache
# --------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local

BROADCAST_CONNECTION=log

# --------------------------------------------------------------------------
# Mail
# --------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --------------------------------------------------------------------------
# Nextcloud / WebDAV
# --------------------------------------------------------------------------
# Use a Nextcloud app password, not your main login password.
#
# Example:
# NEXTCLOUD_BASE_URI=https://cloud.example.com/remote.php/dav/files/alex/
# NEXTCLOUD_USERNAME=alex
# NEXTCLOUD_PASSWORD=your-nextcloud-app-password
# PHOTOBOOK_FOLDER=Photos/Family/2026

NEXTCLOUD_BASE_URI=
NEXTCLOUD_USERNAME=
NEXTCLOUD_PASSWORD=

# Default folder used when no folder is entered in the UI.
# This path is relative to the WebDAV user root.
PHOTOBOOK_FOLDER=Photos

# --------------------------------------------------------------------------
# Photobook layout
# --------------------------------------------------------------------------
PHOTOBOOK_PAPER=a4
PHOTOBOOK_ORIENTATION=landscape
PHOTOBOOK_DPI=150

# Inner white frame around normal pages, in mm.
PHOTOBOOK_PAGE_FRAME_MM=6

# Gap between photo slots, in mm.
PHOTOBOOK_PAGE_GAP_MM=2.5

# --------------------------------------------------------------------------
# Print export
# --------------------------------------------------------------------------
# When enabled, export adds bleed/crop settings and PDF print boxes.
PHOTOBOOK_PRINT_ENABLED=false

# Bleed around the final trim size, in mm.
# A4 landscape with 3mm bleed becomes 303 × 216mm.
PHOTOBOOK_PRINT_BLEED_MM=3

# Draw crop marks into the bleed area.
PHOTOBOOK_PRINT_CROP_MARKS=true

# Extra inner margin near the book spine, in mm.
PHOTOBOOK_PRINT_SPINE_MARGIN_MM=10

# Safe zone inside the trim edge, in mm.
PHOTOBOOK_PRINT_SAFE_ZONE_MM=5

# --------------------------------------------------------------------------
# PDF export runtime
# --------------------------------------------------------------------------
# PDF rendering uses Playwright Chromium.
# Install once with:
# npx playwright install chromium
#
# PDF box post-processing uses Python + pypdf.
# Install once with:
# python3 -m pip install -r scripts/requirements.txt

PHOTOBOOK_PYTHON_BINARY=python3

# --------------------------------------------------------------------------
# Optional ML/photo analysis
# --------------------------------------------------------------------------
# Keep disabled for the first setup unless you know you need it.
PHOTOBOOK_ML_ENABLE=false
PHOTOBOOK_ML_SHARPNESS=true
PHOTOBOOK_ML_PHASH=true
PHOTOBOOK_ML_FACES=false
PHOTOBOOK_ML_AESTHETIC=false
PHOTOBOOK_ML_SALIENCY=false
PHOTOBOOK_ML_HORIZON=false

# --------------------------------------------------------------------------
# Vite
# --------------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"
